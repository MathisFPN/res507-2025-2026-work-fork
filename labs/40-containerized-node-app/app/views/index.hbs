<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>QuoteBoard</title>
<link rel="stylesheet" href="/public/style.css" />
</head>

<body>
  <h1>QuoteBoard v2 - Rollout Test</h1>

  <form method="post" action="/quotes">
    <input name="author" placeholder="Author (optional)" />
    <textarea name="text" placeholder="Write a quote..." required></textarea>
    <button type="submit">Add quote</button>
  </form>

  {{#if quotes.length}}
  {{#each quotes}}
  <div class="quote">
    <div>{{this.text}}</div>
    <div>— {{this.author}}</div>
  </div>
  {{/each}}
  {{else}}
  <p>No quotes yet. Add the first one. boum</p>
  {{/if}}
</body>

</html>